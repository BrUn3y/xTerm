{
  "name": "xterm-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "A terminal with a different point of view.",
  "main": "electron/main.cjs",
  "author": "xTerm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrUn3y/xTerm.git"
  },
  "homepage": "https://github.com/BrUn3y/xTerm#readme",
  "bugs": {
    "url": "https://github.com/BrUn3y/xTerm/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "node --test tests/*.test.cjs",
    "test:pty": "node scripts/test-pty.mjs",
    "test:keyboard-desktop": "node scripts/test-keyboard-desktop.mjs",
    "test:keyboard-stack": "node scripts/test-keyboard-stack.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "6.1.0-beta.339",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "playwright": "1.65.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "studio.xterm.desktop",
    "productName": "xTerm",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
